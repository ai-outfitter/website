---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';

const isDocumentation = Astro.url.pathname.startsWith('/docs/');
---

<div class:list={['documentation-sidebar', { 'has-current-page-toc': isDocumentation }]}>
  <DefaultSidebar />
  {isDocumentation && (
    <div class="current-page-toc" data-current-page-toc>
      <TableOfContents />
    </div>
  )}
</div>

<script>
  const sidebar = document.querySelector('.documentation-sidebar.has-current-page-toc');
  const currentPage = sidebar?.querySelector('a[aria-current="page"]');
  const tableOfContents = sidebar?.querySelector<HTMLElement>('[data-current-page-toc]');

  if (currentPage && tableOfContents?.childElementCount) {
    currentPage.after(tableOfContents);
    tableOfContents.dataset.mounted = '';
  }
</script>

<style>
  .current-page-toc:not([data-mounted]) {
    display: none;
  }

  .current-page-toc {
    margin-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    padding: 0.25rem 0 0.25rem 0.5rem;
  }

  .current-page-toc :global(h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .current-page-toc :global(a) {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .current-page-toc :global(a:hover),
  .current-page-toc :global(a:focus),
  .current-page-toc :global(a[aria-current='true']) {
    color: var(--sl-color-white);
  }
</style>
