---
import WorkflowDiagramFrame from './WorkflowDiagramFrame.astro';

interface Props {
  title: string;
  source: string;
  nodes: Array<{
    id: string;
    title: string;
    kind: 'step' | 'workflow';
    href?: string;
    details: Array<{ label: string; value: string }>;
  }>;
}

const { title, source, nodes } = Astro.props;
---

<WorkflowDiagramFrame title={title} source={source} nodes={nodes} />

<script>
  import { installWorkflowDiagrams } from '../scripts/workflow-diagram';
  void installWorkflowDiagrams();
</script>
