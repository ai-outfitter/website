---
interface Props {
  title: string;
  source: string;
  links?: Array<{ nodeId: string; href: string; title: string }>;
  showSource?: boolean;
  defer?: boolean;
}

const { title, source, links = [], showSource = true, defer = false } = Astro.props;
---

<figure
  class="workflow-diagram"
  data-workflow-diagram
  data-workflow-defer={defer ? '' : undefined}
  data-workflow-links={links.length ? JSON.stringify(links) : undefined}
>
  <div class="workflow-diagram__canvas" role="img" aria-label={`${title} workflow diagram`}></div>
  <p class="workflow-diagram__status" aria-live="polite">Rendering workflow…</p>
  {showSource && (
    <details>
      <summary>View Mermaid source</summary>
      <pre><code data-workflow-source>{source}</code></pre>
    </details>
  )}
  {!showSource && <code data-workflow-source hidden>{source}</code>}
</figure>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: 'strict',
    theme: 'dark',
    flowchart: {
      curve: 'basis',
      htmlLabels: true,
      useMaxWidth: false,
    },
  });

  const narrowScreen = matchMedia('(max-width: 50rem)');
  let renderVersion = 0;

  function bindWorkflowLinks(diagram: HTMLElement, canvas: HTMLElement) {
    const encodedLinks = diagram.dataset.workflowLinks;
    if (!encodedLinks) return;

    const links = JSON.parse(encodedLinks) as Array<{ nodeId: string; href: string; title: string }>;
    const nodes = [...canvas.querySelectorAll<SVGGElement>('g.node.workflowRef')];
    for (const link of links) {
      const escapedNodeId = link.nodeId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const nodeId = new RegExp(`-flowchart-${escapedNodeId}-\\d+$`);
      const node = nodes.find((candidate) => nodeId.test(candidate.id));
      if (!node) continue;

      const anchor = document.createElementNS('http://www.w3.org/2000/svg', 'a');
      anchor.setAttribute('href', link.href);
      anchor.setAttribute('aria-label', `Open ${link.title} workflow`);
      anchor.setAttribute('class', 'workflow-diagram__link');
      while (node.firstChild) anchor.appendChild(node.firstChild);
      node.appendChild(anchor);
    }
  }

  async function renderDiagram(diagram: HTMLElement, force = false) {
    if (diagram.dataset.workflowRendered === 'true' && !force) return;

    const canvas = diagram.querySelector<HTMLElement>('.workflow-diagram__canvas');
    const data = diagram.querySelector<HTMLElement>('[data-workflow-source]');
    const status = diagram.querySelector<HTMLElement>('.workflow-diagram__status');
    if (!canvas || !data || !status) return;

    status.hidden = false;
    status.textContent = 'Rendering workflow…';
    status.classList.remove('workflow-diagram__error');
    try {
      const source = (data.textContent ?? '').replace(/^flowchart\s+(LR|TB)/, `flowchart ${narrowScreen.matches ? 'TB' : 'LR'}`);
      const rendered = await mermaid.render(
        `workflow-${narrowScreen.matches ? 'tb' : 'lr'}-${renderVersion++}`,
        source,
      );
      canvas.innerHTML = rendered.svg;
      rendered.bindFunctions?.(canvas);
      bindWorkflowLinks(diagram, canvas);
      diagram.dataset.workflowRendered = 'true';
      status.textContent = '';
      status.hidden = true;
    } catch (error) {
      canvas.innerHTML = '';
      status.hidden = false;
      status.classList.add('workflow-diagram__error');
      status.textContent = `The workflow diagram could not be rendered: ${error instanceof Error ? error.message : String(error)}`;
    }
  }

  const diagrams = [...document.querySelectorAll<HTMLElement>('[data-workflow-diagram]')];
  for (const diagram of diagrams) {
    diagram.addEventListener('workflow-diagram:render', () => void renderDiagram(diagram));
    if (!diagram.hasAttribute('data-workflow-defer')) void renderDiagram(diagram);
  }
  narrowScreen.addEventListener('change', () => {
    for (const diagram of diagrams) {
      if (diagram.dataset.workflowRendered === 'true') void renderDiagram(diagram, true);
    }
  });
</script>

<style>
  .workflow-diagram {
    margin-block: 2rem;
  }

  .workflow-diagram__canvas {
    display: grid;
    min-height: 26rem;
    place-items: center;
    overflow: auto;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: #0f1728;
  }

  .workflow-diagram__canvas :global(svg) {
    min-width: 62rem;
    max-width: none;
    height: auto;
  }

  .workflow-diagram__canvas :global(.workflow-diagram__link) {
    cursor: pointer;
  }

  .workflow-diagram__canvas :global(.workflow-diagram__link:hover .label-container),
  .workflow-diagram__canvas :global(.workflow-diagram__link:focus-visible .label-container) {
    filter: brightness(1.2);
    stroke-width: 5px !important;
  }

  .workflow-diagram__status {
    min-height: 1.5rem;
    margin-block: 0.5rem 0;
    color: #b7c4dc;
  }

  .workflow-diagram__error {
    color: #ff9caf;
  }

  details {
    margin-top: 0.75rem;
  }

  details pre {
    max-height: 24rem;
  }

  @media (max-width: 50rem) {
    .workflow-diagram__canvas {
      min-height: 18rem;
      padding: 0.75rem;
    }

    .workflow-diagram__canvas :global(svg) {
      min-width: 0;
      width: 100%;
      max-width: 100%;
    }
  }
</style>
