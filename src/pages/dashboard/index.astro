---
import SiteShell from '../../layouts/SiteShell.astro';
---

<SiteShell
  title="Dashboard"
  description="Manage workflow bundles in a personal or organization-owned .agents repository."
>
  <main class="site-frame dashboard" data-dashboard>
    <section id="signed-out" class="panel" hidden>
      <h2>Connect the AI Outfitter GitHub App</h2>
      <p>Sign in to manage the <code>.agents</code> repositories available to the App.</p>
      <button id="sign-in" class="button primary" type="button">Sign in with GitHub</button>
    </section>

    <section id="signed-in" hidden>
      <section id="dashboard-overview" hidden>
        <section class="panel configuration">
          <div class="section-heading">
            <div>
              <p class="panel-label">Repository configuration</p>
              <h2 id="configuration-title">Loading account…</h2>
            </div>
            <div class="actions">
              <a id="repository-link" href="#" hidden>Open on GitHub</a>
            </div>
          </div>
          <div id="configuration-summary" class="configuration-summary"></div>
          <details id="settings-details" class="settings-file">
            <summary>View exact settings.yml</summary>
            <pre id="settings-yaml"></pre>
          </details>
          <div class="source-section">
            <h3>Catalog sources</h3>
            <div id="catalog-sources" class="source-grid"></div>
          </div>
          <div id="remote-source-section" class="source-section" hidden>
            <h3>Remote settings</h3>
            <div id="remote-sources" class="source-grid"></div>
          </div>
        </section>

        <section class="workflow-status-section">
          <div class="section-heading">
            <div>
              <p class="panel-label">Repository workflows</p>
              <h2>Installed</h2>
            </div>
          </div>
          <div id="installed-workflows" class="workflow-grid"></div>
        </section>

        <section class="workflow-status-section">
          <div class="section-heading">
            <div>
              <p class="panel-label">Available from AI Outfitter</p>
              <h2>Community profiles</h2>
            </div>
          </div>
          <div id="community-workflows" class="workflow-grid"></div>
        </section>

        <div id="source-plan" class="panel plan-panel" hidden>
          <h2>Preview source change</h2>
          <div id="source-preview" class="preview"></div>
          <div id="source-apply-actions" class="actions" hidden>
            <button class="button primary" type="button" data-apply="pull-request">Open pull request</button>
            <button class="button" type="button" data-apply="direct">Commit to default branch</button>
          </div>
        </div>
      </section>

      <section id="workflow-manager" class="panel manager" hidden>
        <a id="manager-back" href="#">← Repository overview</a>
        <div class="section-heading">
          <div>
            <p class="panel-label">Workflow manager</p>
            <h2 id="manager-title">Loading workflow…</h2>
          </div>
          <span id="manager-state" class="badge"></span>
        </div>
        <p id="manager-description" class="lede small"></p>
        <dl id="manager-metadata" class="metadata"></dl>
        <div class="manager-grid">
          <div>
            <label for="install-strategy">Installation strategy</label>
            <select id="install-strategy">
              <option value="catalog-reference">Pinned catalog reference</option>
              <option value="vendored">Vendored files</option>
            </select>
            <p class="muted">Use a pinned source in settings.yml, or copy the workflow files into the repository.</p>
          </div>
          <div id="repository-options" hidden>
            <label for="visibility">New repository visibility</label>
            <select id="visibility">
              <option value="public">Public</option>
              <option value="private">Private</option>
            </select>
          </div>
        </div>
        <div id="workflow-actions" class="actions"></div>
        <div id="workflow-preview" class="preview"></div>
        <div id="workflow-apply-actions" class="actions" hidden>
          <button class="button primary" type="button" data-apply="pull-request">Open pull request</button>
          <button class="button" type="button" data-apply="direct">Commit to default branch</button>
        </div>
      </section>
    </section>

    <p id="dashboard-status" class="status" role="status" aria-live="polite"></p>
  </main>

  <script>
    import { installDashboardLifecycle } from '../../scripts/dashboard-app';
    installDashboardLifecycle();
  </script>
</SiteShell>

<style is:global>
  .dashboard [hidden] { display: none !important; }
  .dashboard { padding-block: clamp(3rem, 7vw, 7rem); }
  .dashboard .dashboard-hero { max-width: 60rem; margin-bottom: 3rem; }
  .dashboard h1 { max-width: 13ch; margin: .55rem 0 1.5rem; font-size: clamp(3.2rem, 9vw, 7.8rem); letter-spacing: -.07em; line-height: .86; }
  .dashboard h2 { margin: .35rem 0 1rem; font-size: clamp(1.7rem, 4vw, 2.7rem); letter-spacing: -.04em; }
  .dashboard h3 { margin: .8rem 0 .5rem; }
  .dashboard .lede { max-width: 52rem; color: var(--site-muted); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
  .dashboard .lede.small { font-size: 1rem; }
  .dashboard .panel { margin-block: 1rem; padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--site-line); background: color-mix(in srgb, var(--site-canvas) 94%, transparent); }
  .dashboard .panel-label { margin: 0 0 .45rem; color: var(--site-signal); font: 750 .7rem var(--site-font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .dashboard .button, .dashboard select { border: 1px solid var(--site-signal); border-radius: 0; background: transparent; color: var(--site-signal-high); font: 750 .78rem Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .dashboard .button { display: inline-block; padding: .75rem .95rem; cursor: pointer; text-decoration: none; }
  .dashboard .button.primary { background: var(--site-signal); color: #211107; }
  .dashboard .button:disabled { cursor: not-allowed; opacity: .45; }
  .dashboard select { min-width: min(100%, 18rem); padding: .7rem; background: var(--site-ink); text-transform: none; }
  .dashboard label { display: block; margin-bottom: .45rem; font-weight: 700; }
  .dashboard .muted, .dashboard .status { color: var(--site-muted); }
  .dashboard .section-heading, .dashboard .actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .dashboard .actions { justify-content: flex-start; }
  .dashboard .workflow-grid, .dashboard .source-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
  .dashboard .workflow-card, .dashboard .source-card { display: block; padding: 1.15rem; border: 1px solid var(--site-line); background: var(--site-ink); color: inherit; text-decoration: none; }
  .dashboard .workflow-card:hover { border-color: var(--site-signal); }
  .dashboard .manager-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, .7fr); gap: 1rem; margin-block: 1.5rem; }
  .dashboard .preview { margin-top: 1.5rem; }
  .dashboard .preview details { border-top: 1px solid var(--site-line); padding-block: .8rem; }
  .dashboard .preview pre { overflow: auto; padding: 1rem; background: #090a08; color: var(--site-text); white-space: pre-wrap; }
  .dashboard .workflow-status-section { margin-top: 4rem; }
  .dashboard .workflow-card { min-height: 12rem; }
  .dashboard .workflow-card p, .dashboard .source-card p { color: var(--site-muted); line-height: 1.55; }
  .dashboard .source-section { margin-top: 2rem; }
  .dashboard .source-card dl, .dashboard .metadata { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .4rem 1rem; }
  .dashboard dt { color: var(--site-dim); font: 700 .72rem var(--site-font-mono); text-transform: uppercase; }
  .dashboard dd { min-width: 0; margin: 0; overflow-wrap: anywhere; }
  .dashboard .configuration-summary { display: flex; gap: .6rem; flex-wrap: wrap; margin-block: 1.2rem; }
  .dashboard .settings-file { border-block: 1px solid var(--site-line); padding-block: 1rem; }
  .dashboard .settings-file summary { cursor: pointer; font-weight: 700; }
  .dashboard .settings-file pre { max-height: 28rem; overflow: auto; padding: 1rem; background: #090a08; white-space: pre; }
  .dashboard .plan-panel { margin-top: 3rem; }
  .dashboard .badge { display: inline-block; padding: .25rem .5rem; border: 1px solid currentColor; border-radius: 999px; font: 750 .68rem var(--site-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .dashboard .badge.planned { color: var(--site-dim); }
  .dashboard .badge.available, .dashboard .badge.installed { color: var(--site-signal-high); }
  .dashboard .badge.outdated, .dashboard .badge.needs-configuration { color: #ffd46b; }
  .dashboard .badge.overridden, .dashboard .badge.diverged, .dashboard .badge.invalid { color: var(--site-danger); }
  .dashboard .badge.current, .dashboard .badge.local-only { color: var(--site-signal-high); }
  .dashboard .badge.ahead, .dashboard .badge.unpinned, .dashboard .badge.unavailable { color: #ffd46b; }
  .dashboard .status { min-height: 1.5rem; margin-top: 2rem; }
  @media (max-width: 48rem) { .dashboard .manager-grid { grid-template-columns: 1fr; } }
</style>
