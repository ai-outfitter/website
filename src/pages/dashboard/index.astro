---
import { plannedCapabilities } from '../../dashboard/capabilities';
import SiteShell from '../../layouts/SiteShell.astro';
---

<SiteShell
  title="Dashboard"
  description="Manage validated workflow closures in your personal or organization .agents repository."
>
  <main class="site-frame dashboard" data-dashboard>
    <section class="dashboard-hero">
      <p class="eyebrow">GitHub-native configuration</p>
      <h1>Outfit your agent team.</h1>
      <p class="lede">
        Install validated workflow closures into the <code>.agents</code> repository owned by you or your
        organization. Every update is previewed as exact files before it reaches GitHub.
      </p>
    </section>

    <section id="signed-out" class="panel">
      <p class="panel-label">Available now</p>
      <h2>Connect the AI Outfitter GitHub App</h2>
      <p>Sign in to manage only repositories named <code>.agents</code> that the App installation can access.</p>
      <button id="sign-in" class="button primary" type="button">Sign in with GitHub</button>
    </section>

    <section id="signed-in" hidden>
      <div class="toolbar panel">
        <div>
          <p class="panel-label">Active account</p>
          <label for="account">Manage configuration for</label>
          <select id="account"></select>
        </div>
        <div class="toolbar-actions">
          <a id="install-app" class="button" href="https://github.com/apps/ai-outfitter/installations/new">Add account</a>
          <button id="sign-out" class="button" type="button">Sign out</button>
        </div>
      </div>

      <div id="account-cards" class="account-grid" aria-label="Accessible accounts"></div>

      <section class="panel manager">
        <div class="section-heading">
          <div>
            <p class="panel-label">Repository configuration</p>
            <h2 id="manager-title">Loading account…</h2>
          </div>
          <a id="repository-link" href="#" hidden>Open on GitHub</a>
        </div>

        <div class="manager-grid">
          <div>
            <label for="workflow">Workflow closure</label>
            <select id="workflow"></select>
            <p id="workflow-description" class="muted"></p>
          </div>
          <div id="local-readiness" class="readiness"></div>
        </div>

        <div id="create-repository" hidden>
          <p>This account does not have an accessible <code>.agents</code> repository.</p>
          <div class="actions">
            <label for="visibility">Visibility</label>
            <select id="visibility">
              <option value="public">Public</option>
              <option value="private">Private</option>
            </select>
            <button id="create" class="button primary" type="button">Create .agents repository</button>
          </div>
        </div>

        <div id="manage-repository" hidden>
          <h3>Installed resources</h3>
          <p class="muted">Selecting a resource removes every managed workflow that owns it.</p>
          <div id="resources" class="resource-grid"></div>
          <div class="actions">
            <button id="preview" class="button primary" type="button">Preview exact changes</button>
          </div>
          <div id="preview-output" class="preview"></div>
          <div id="apply-actions" class="actions" hidden>
            <button id="open-pr" class="button primary" type="button">Open pull request</button>
            <button id="direct-commit" class="button" type="button">Commit to default branch</button>
          </div>
        </div>
      </section>

      <section class="workflow-status-section">
        <div class="section-heading">
          <div>
            <p class="panel-label">Catalog status</p>
            <h2>Workflow closures</h2>
          </div>
        </div>
        <div id="workflow-cards" class="workflow-grid"></div>
      </section>
    </section>

    <section class="roadmap-section" aria-labelledby="roadmap-title">
      <p class="eyebrow">Design-stage direction</p>
      <h2 id="roadmap-title">Planned control-plane capabilities</h2>
      <p class="lede small">
        These are explicit extension points, not active services. They cannot run agents, receive credentials,
        or change infrastructure today.
      </p>
      <div class="roadmap-grid">
        {plannedCapabilities.map((capability) => (
          <article class="roadmap-card" data-capability={capability.id}>
            <span class="badge planned">Planned</span>
            <h3>{capability.title}</h3>
            <p>{capability.summary}</p>
            <ul>
              {capability.prerequisites?.map((prerequisite) => <li>{prerequisite}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <p id="dashboard-status" class="status" role="status" aria-live="polite"></p>
  </main>

  <script>
    import { startDashboard } from '../../scripts/dashboard';
    startDashboard();
  </script>
</SiteShell>

<style>
  .dashboard { padding-block: clamp(3rem, 7vw, 7rem); }
  .dashboard-hero { max-width: 60rem; margin-bottom: 3rem; }
  h1 { max-width: 13ch; margin: .55rem 0 1.5rem; font-size: clamp(3.2rem, 9vw, 7.8rem); letter-spacing: -.07em; line-height: .86; }
  h2 { margin: .35rem 0 1rem; font-size: clamp(1.7rem, 4vw, 2.7rem); letter-spacing: -.04em; }
  h3 { margin: .8rem 0 .5rem; }
  .lede { max-width: 52rem; color: var(--site-muted); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
  .lede.small { font-size: 1rem; }
  .panel { margin-block: 1rem; padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--site-line); background: color-mix(in srgb, var(--site-canvas) 94%, transparent); }
  .panel-label { margin: 0 0 .45rem; color: var(--site-signal); font: 750 .7rem var(--site-font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .button, select { border: 1px solid var(--site-signal); border-radius: 0; background: transparent; color: var(--site-signal-high); font: 750 .78rem Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .button { display: inline-block; padding: .75rem .95rem; cursor: pointer; text-decoration: none; }
  .button.primary { background: var(--site-signal); color: #211107; }
  .button:disabled { cursor: not-allowed; opacity: .45; }
  select { min-width: min(100%, 18rem); padding: .7rem; background: var(--site-ink); text-transform: none; }
  label { display: block; margin-bottom: .45rem; font-weight: 700; }
  .muted, .status { color: var(--site-muted); }
  .toolbar, .section-heading, .actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .toolbar-actions, .actions { justify-content: flex-start; }
  .account-grid, .workflow-grid, .roadmap-grid, .resource-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
  .account-grid { margin-block: 1rem 3rem; }
  .account-card, .workflow-card, .roadmap-card, .resource-card, .readiness { padding: 1.15rem; border: 1px solid var(--site-line); background: var(--site-ink); }
  .account-card[data-active='true'] { border-color: var(--site-signal); }
  .counts { display: flex; flex-wrap: wrap; gap: .7rem; color: var(--site-muted); font-size: .8rem; }
  .manager-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, .7fr); gap: 1rem; margin-block: 1.5rem; }
  .resource-card label { display: flex; gap: .7rem; align-items: flex-start; }
  .preview { margin-top: 1.5rem; }
  .preview details { border-top: 1px solid var(--site-line); padding-block: .8rem; }
  .preview pre { overflow: auto; padding: 1rem; background: #090a08; color: var(--site-text); white-space: pre-wrap; }
  .workflow-status-section, .roadmap-section { margin-top: 5rem; }
  .workflow-card, .roadmap-card { min-height: 14rem; }
  .workflow-card p, .roadmap-card p, .roadmap-card li { color: var(--site-muted); line-height: 1.55; }
  .roadmap-card ul { margin: 1rem 0 0; padding-left: 1.2rem; font-size: .82rem; }
  .badge { display: inline-block; padding: .25rem .5rem; border: 1px solid currentColor; border-radius: 999px; font: 750 .68rem var(--site-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .badge.planned { color: var(--site-dim); }
  .badge.available, .badge.installed { color: var(--site-signal-high); }
  .badge.outdated, .badge.needs-configuration { color: #ffd46b; }
  .badge.overridden { color: var(--site-danger); }
  .status { min-height: 1.5rem; margin-top: 2rem; }
  @media (max-width: 48rem) { .manager-grid { grid-template-columns: 1fr; } }
</style>
