---
import SiteShell from './SiteShell.astro';

const { title, description } = Astro.props.frontmatter;
---

<SiteShell title={title} description={description}>
  <main class="site-frame workflow-page" data-pagefind-body>
    <div class="eyebrow">Workflow atlas</div>
    <h1 data-pagefind-meta="title">{title}</h1>
    {description && <p class="lede">{description}</p>}
    <article><slot /></article>
  </main>
</SiteShell>

<style is:global>
  .workflow-page { padding-block: clamp(3rem, 7vw, 7rem); }
  .workflow-page h1 { max-width: 18ch; margin: .55rem 0 0; font-size: clamp(3rem, 8vw, 7.5rem); letter-spacing: -.065em; line-height: .9; }
  .workflow-page .lede { max-width: 48rem; margin: 1.5rem 0 3rem; color: var(--site-muted); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.6; }
  .workflow-page article { margin-top: 3rem; }
  .workflow-page article > :not(.workflow-diagram) { max-width: 52rem; }
  .workflow-page article h2, .workflow-page article h3 { margin-top: 2.5rem; letter-spacing: -.025em; }
  .workflow-page article p, .workflow-page article li { color: var(--site-text); line-height: 1.7; }
  .workflow-page article li + li { margin-top: .6rem; }
  .workflow-page article code { padding: .12rem .3rem; border: 1px solid var(--site-line); background: var(--site-canvas-raised); color: var(--site-signal-high); }
  .workflow-page article table { width: 100%; border-collapse: collapse; overflow-x: auto; display: block; }
  .workflow-page article th, .workflow-page article td { padding: .75rem; border-bottom: 1px solid var(--site-line); text-align: left; vertical-align: top; }
  .workflow-section { max-width: none !important; margin-top: 5rem; }
  .workflow-section > h2 { margin-bottom: .6rem; font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .workflow-section > p { max-width: 52rem; margin-top: 0; }
  .workflow-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin-top: 1.75rem; }
  .workflow-grid--delivery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .workflow-card { min-height: 17rem; display: flex; flex-direction: column; padding: 1.4rem; border: 1px solid var(--site-line); background: linear-gradient(145deg, var(--site-canvas-raised), var(--site-canvas)); color: inherit; text-decoration: none; transition: border-color .15s ease, transform .15s ease; }
  .workflow-card:hover { border-color: var(--site-signal); transform: translateY(-2px); }
  .workflow-section--delivery .workflow-card { border-top: 3px solid var(--site-signal); }
  .workflow-card__meta { min-height: 2.4em; color: var(--site-signal-high); font-family: ui-monospace, monospace; font-size: .7rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .workflow-card h3 { margin: 1rem 0 .6rem; font-size: 1.55rem; }
  .workflow-card p { margin: 0; color: var(--site-muted); font-size: .95rem; line-height: 1.55; }
  .workflow-card__tags { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
  .workflow-card__tags li { display: inline-flex; align-items: center; gap: .35rem; margin: 0; padding: .3rem .55rem; border: 1px solid var(--site-line); border-radius: 999px; background: var(--site-canvas); color: var(--site-text); font-size: .72rem; line-height: 1.2; }
  .workflow-card__tags li span { color: var(--site-signal-high); font-weight: 750; }
  .workflow-card__action { margin-top: auto; padding-top: 1.5rem; color: var(--site-signal-high); font-size: .75rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 60rem) { .workflow-grid--delivery { grid-template-columns: 1fr; } }
</style>
