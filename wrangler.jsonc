{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-outfitter-website",
  "account_id": "52b3dd3372a05fd2be0eb0f8ec36f9d3",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ai-outfitter.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/auth/*", "/api/cli/*", "/cli/authorize", "/api/accounts", "/api/accounts/*", "/api/webhooks/*", "/dashboard/*"]
  },
  "vars": {
    "CLI_AUTH_ENABLED": "false",
    "BETTER_AUTH_URL": "https://ai-outfitter.com",
    "GITHUB_APP_SLUG": "ai-outfitter",
    "GITHUB_APP_ID": "4253427",
    "GITHUB_CLIENT_ID": "Iv23lipcbgzyqZYb1kNX",
    "FACTORY_AUTO_START_ACTOR_IDS": "8276365"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GITHUB_USER_GRANTS", "class_name": "GitHubUserGrant" },
      { "name": "CLI_DEVICES", "class_name": "CliDevice" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GitHubUserGrant"] },
    { "tag": "cli-auth-v1", "new_sqlite_classes": ["CliDevice"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "CLI_AUTH_ENABLED": "false",
        "BETTER_AUTH_URL": "https://ai-outfitter.com",
        "GITHUB_APP_SLUG": "ai-outfitter",
        "GITHUB_APP_ID": "4253427",
        "GITHUB_CLIENT_ID": "Iv23lipcbgzyqZYb1kNX",
        "FACTORY_AUTO_START_ACTOR_IDS": "8276365"
      },
      "durable_objects": {
        "bindings": [
          { "name": "GITHUB_USER_GRANTS", "class_name": "GitHubUserGrant" },
          { "name": "CLI_DEVICES", "class_name": "CliDevice" }
        ]
      }
    }
  }
}
