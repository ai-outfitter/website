{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-outfitter-website",
  "account_id": "52b3dd3372a05fd2be0eb0f8ec36f9d3",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ai-outfitter.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/agents", "/agents/*", "/api/agents/*", "/api/auth/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://ai-outfitter.com",
    "GITHUB_APP_SLUG": "ai-outfitter",
    "COMMUNITY_REPOSITORY": "ai-outfitter/community-profiles",
    "COMMUNITY_REF": "HEAD"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GITHUB_USER_GRANTS", "class_name": "GitHubUserGrant" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GitHubUserGrant"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
