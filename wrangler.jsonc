{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-outfitter-website",
  "account_id": "52b3dd3372a05fd2be0eb0f8ec36f9d3",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ai-outfitter.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/auth/*",
      "/api/accounts",
      "/api/accounts/*",
      "/api/webhooks/*",
      "/dashboard/*",
      "/api/billing/*"
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://ai-outfitter.com",
    "GITHUB_APP_SLUG": "ai-outfitter",
    "GITHUB_APP_ID": "4253427",
    "GITHUB_CLIENT_ID": "Iv23lipcbgzyqZYb1kNX",
    "FACTORY_AUTO_START_ACTOR_IDS": "8276365",
    "BILLING_ENABLED": "false",
    "STRIPE_LIVE_MODE": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GITHUB_USER_GRANTS",
        "class_name": "GitHubUserGrant"
      },
      {
        "name": "BILLING_ACCOUNTS",
        "class_name": "BillingAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GitHubUserGrant"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "BillingAccount"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "BETTER_AUTH_URL": "https://ai-outfitter.com",
        "GITHUB_APP_SLUG": "ai-outfitter",
        "GITHUB_APP_ID": "4253427",
        "GITHUB_CLIENT_ID": "Iv23lipcbgzyqZYb1kNX",
        "FACTORY_AUTO_START_ACTOR_IDS": "8276365",
        "BILLING_ENABLED": "false",
        "STRIPE_LIVE_MODE": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GITHUB_USER_GRANTS",
            "class_name": "GitHubUserGrant"
          },
          {
            "name": "BILLING_ACCOUNTS",
            "class_name": "BillingAccount"
          }
        ]
      }
    },
    "beta": {
      "name": "ai-outfitter-website-beta",
      "main": "src/beta-worker.ts",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "beta.ai-outfitter.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "404-page",
        "run_worker_first": true
      },
      "vars": {
        "BETTER_AUTH_URL": "https://beta.ai-outfitter.com",
        "GITHUB_APP_SLUG": "ai-outfitter",
        "GITHUB_APP_ID": "4253427",
        "GITHUB_CLIENT_ID": "Iv23lipcbgzyqZYb1kNX",
        "FACTORY_AUTO_START_ACTOR_IDS": "",
        "BILLING_ENABLED": "true",
        "STRIPE_LIVE_MODE": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GITHUB_USER_GRANTS",
            "class_name": "GitHubUserGrant"
          },
          {
            "name": "BILLING_ACCOUNTS",
            "class_name": "BillingAccount"
          }
        ]
      }
    }
  }
}
